      <column caption='Borough (taxi zone lookup.csv1)' datatype='string' name='[Borough (taxi_zone_lookup.csv1)]' role='dimension' type='nominal' />
      <column caption='Trip Time ' datatype='integer' name='[Calculation_0851079711567872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//trip time&#13;&#10;DATEDIFF(&apos;minute&apos;,[lpep_pickup_datetime],[lpep_dropoff_datetime])' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_0851079715061761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[payment_type]' />
      </column>
      <column caption='Time of Day' datatype='string' name='[Calculation_0851079719751682]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;= 4 and DATEPART(&apos;hour&apos;,[lpep_pickup_datetime]) &lt;= 10 Then &quot;morning&quot;&#13;&#10;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;= 11 and DATEPART(&apos;hour&apos;,[lpep_pickup_datetime]) &lt;= 16 Then &quot;Afternoon&quot;&#13;&#10;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;= 17 and DATEPART(&apos;hour&apos;,[lpep_pickup_datetime]) &lt;= 21 Then &quot;Night&quot;&#13;&#10;&#13;&#10;ELSE &quot;Late Night&quot;&#13;&#10;END' />
      </column>
      <column caption='Top 5 parameters' datatype='real' name='[Calculation_1094896766980099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1094896765829120]&#13;&#10;&#13;&#10;WHEN &quot;Average Revenue&quot; THEN AVG([total_amount])&#13;&#10;WHEN &quot;Average Tip Amount&quot; THEN AVG([tip_amount])&#13;&#10;END' />
      </column>
